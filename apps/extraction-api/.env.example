# Copy this file to .env in the same directory:
#     cp apps/extraction-api/.env.example apps/extraction-api/.env
#
# The service loads apps/extraction-api/.env and the repo-root .env automatically on start.
# Values already present in the environment always win, so an exported variable or a
# platform's own config is never overridden by this file.
#
# Verify it works:  pnpm check:openai

# The name must be exactly this. OPENAI_KEY / OPENAI_TOKEN are not read (the server warns
# if it finds one of those and no OPENAI_API_KEY).
#
# Only needed for the LLM escalation path -- pages whose layout the rules parser cannot read.
# NOTE: no document in sample-files-variant/ escalates, so a key changes nothing for them.
# Use `node scripts/make-unfamiliar-invoice.mjs` to produce one that does.
#
# The test suite NEVER reads this key. No suite makes a live OpenAI call.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-4o-2024-08-06.
# OPENAI_MODEL=gpt-4o-2024-08-06

# Optional. Defaults to 3001.
PORT=3001
