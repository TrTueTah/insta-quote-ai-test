# Where the extraction service (Part A) is running.
#
# Server-side only: this value is read inside the route handler and is NEVER sent to the
# browser, so the extraction service's address is not exposed to page visitors.
#
# Local development (Part A default port):
EXTRACTION_API_URL=http://localhost:3001

# In production this points at the deployed extraction service, e.g.
# EXTRACTION_API_URL=https://insta-quote-extraction-api.up.railway.app

# Deployment note: the route handler forwards uploads and waits up to 60 seconds, so the
# platform's function timeout must exceed that. vercel.json sets maxDuration to 90.
